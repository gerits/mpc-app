{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiniStation",
  "version": "0.1.0",
  "identifier": "com.ministation.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MiniStation — Akai Performance Workstation",
        "width": 1120,
        "height": 760,
        "minWidth": 980,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
